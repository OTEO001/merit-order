<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }} — {{ tagline }}</title>
<script>document.documentElement.classList.add('js')</script>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#070A12; --bg-2:#0A0E18;
    --panel:#0D1119; --panel-2:#0B0F17; --glass:rgba(18,24,36,.55);
    --line:#1B2230; --line-2:#27303F;
    --t1:#EAEEF5; --t2:#9BA6B6; --t3:#5C6675;
    --pos:#34D399; --neg:#F87171; --accent:#4FD1C5; --accent-2:#7DD3FC;
    --serif:'Fraunces',Georgia,serif;
    --sans:'IBM Plex Sans',system-ui,-apple-system,sans-serif;
    --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,monospace;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--t1);font-family:var(--sans);
    font-size:14px;line-height:1.55;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
    overflow-x:hidden}
  /* ambient depth */
  body::before{content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;
    background:
      radial-gradient(1100px 620px at 78% -8%, rgba(79,209,197,.10), transparent 60%),
      radial-gradient(900px 600px at 8% 4%, rgba(125,211,252,.06), transparent 55%),
      linear-gradient(180deg, var(--bg-2), var(--bg) 38%)}
  .mono{font-family:var(--mono);font-variant-numeric:tabular-nums}
  .wrap{max-width:1200px;margin:0 auto;padding:0 24px 96px}
  a{color:var(--accent);text-decoration:none}

  /* reveal animation — only hidden when JS is present, so no-JS renders fully */
  .js .rise{opacity:0;transform:translateY(14px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1)}
  .rise.in{opacity:1;transform:none}

  /* masthead */
  .mast{display:flex;align-items:center;gap:14px;padding:24px 0 18px}
  .brand{display:flex;align-items:center;gap:11px;font-weight:600;font-size:15px;
    letter-spacing:.24em;text-transform:uppercase;color:var(--t1)}
  .brand .tick{width:9px;height:9px;background:var(--accent);transform:rotate(45deg);
    box-shadow:0 0 14px rgba(79,209,197,.7)}
  .mast .clock{margin-left:auto;text-align:right;font-family:var(--mono);
    font-variant-numeric:tabular-nums;font-size:12px;color:var(--t2)}
  .mast .clock .z{color:var(--t3);font-size:10px;letter-spacing:.12em;margin-left:5px}
  .mast .clock .upd{color:var(--t3);font-size:10.5px;margin-top:3px}

  /* hero */
  .hero{padding:18px 0 30px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);
    margin-bottom:6px;position:relative}
  .eyebrow{display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:10.5px;
    letter-spacing:.24em;text-transform:uppercase;color:var(--t3);margin-bottom:18px;flex-wrap:wrap}
  .eyebrow .pill{display:inline-flex;align-items:center;gap:7px;padding:4px 10px;border:1px solid var(--line-2);
    border-radius:999px;color:var(--accent);letter-spacing:.12em}
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent)}
  .headline{font-family:var(--serif);font-weight:500;font-size:clamp(28px,4.6vw,52px);line-height:1.08;
    letter-spacing:-.015em;color:#fff;margin:0 0 8px;max-width:22ch}
  .headline b{color:var(--accent);font-weight:600}
  .mood-up .headline b{color:var(--pos)}
  .mood-down .headline b{color:var(--neg)}
  .changed{margin-top:16px;font-family:var(--mono);font-size:12.5px;color:var(--t1);
    display:flex;align-items:center;gap:12px;flex-wrap:wrap;line-height:1.7}
  .changed .chgk{font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);
    border:1px solid var(--line-2);border-radius:999px;padding:3px 9px}

  /* mood badge — the regime call, rendered with actual color-coded weight */
  .moodrow{display:flex;align-items:center;gap:14px;margin:2px 0 16px;flex-wrap:wrap}
  .moodtag{font-family:var(--mono);font-weight:700;font-size:12.5px;letter-spacing:.08em;
    padding:7px 15px;border-radius:8px;text-transform:uppercase;white-space:nowrap}
  .mood-flat .moodtag{background:rgba(79,209,197,.14);color:var(--accent);border:1px solid rgba(79,209,197,.4)}
  .mood-up .moodtag{background:rgba(52,211,153,.14);color:var(--pos);border:1px solid rgba(52,211,153,.4)}
  .mood-down .moodtag{background:rgba(248,113,113,.14);color:var(--neg);border:1px solid rgba(248,113,113,.4)}
  .moodsub{font-size:13px;color:var(--t2);max-width:52ch}

  /* ambient glow shifts with the regime call — subtle, not gaudy */
  body:has(.mood-up)::before{background:
      radial-gradient(1100px 620px at 78% -8%, rgba(52,211,153,.13), transparent 60%),
      radial-gradient(900px 600px at 8% 4%, rgba(125,211,252,.06), transparent 55%),
      linear-gradient(180deg, var(--bg-2), var(--bg) 38%)}
  body:has(.mood-down)::before{background:
      radial-gradient(1100px 620px at 78% -8%, rgba(248,113,113,.13), transparent 60%),
      radial-gradient(900px 600px at 8% 4%, rgba(125,211,252,.06), transparent 55%),
      linear-gradient(180deg, var(--bg-2), var(--bg) 38%)}

  /* notable-today — the hook: bold, numbered, no chart required to land */
  .notable{border:1px solid var(--line);border-radius:14px;overflow:hidden;
    background:var(--glass);backdrop-filter:blur(8px)}
  .ntitem{display:flex;align-items:baseline;gap:18px;padding:17px 22px}
  .ntitem+.ntitem{border-top:1px solid var(--line)}
  .ntnum{font-family:var(--mono);font-size:11px;color:var(--accent);letter-spacing:.08em;
    flex-shrink:0;padding-top:3px}
  .nttxt{font-family:var(--serif);font-size:17.5px;color:#fff;line-height:1.45;letter-spacing:-.005em}


  /* hero stat strip */
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);
    border:1px solid var(--line);border-radius:12px;overflow:hidden;margin:26px 0 0}
  .stat{background:linear-gradient(180deg,rgba(255,255,255,.012),transparent);padding:16px 18px}
  .stat .l{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--t3);margin-bottom:8px}
  .stat .n{font-family:var(--mono);font-variant-numeric:tabular-nums;font-size:26px;color:#fff;line-height:1}
  .stat .n small{font-size:12px;color:var(--t3);margin-left:3px}
  .stat .d{font-family:var(--mono);font-size:11.5px;margin-top:7px;color:var(--t3)}
  .stat .d.pos{color:var(--pos)} .stat .d.neg{color:var(--neg)}
  .rangebar{position:relative;height:3px;background:var(--line-2);border-radius:2px;margin-top:12px}
  .rangebar i{position:absolute;top:-2.5px;width:7px;height:7px;border-radius:50%;background:var(--accent);
    box-shadow:0 0 8px rgba(79,209,197,.8);transform:translateX(-50%);font-style:normal}
  .rangelbl{display:flex;justify-content:space-between;margin-top:6px;font-family:var(--mono);
    font-size:9.5px;color:var(--t3);letter-spacing:.02em}
  .rangelbl span:nth-child(2){letter-spacing:.14em;text-transform:uppercase}

  /* market structure: yield curve + risk gauge */
  .structure{display:grid;grid-template-columns:1.6fr 1fr;gap:14px}
  .panel.curve h3,.panel.gauge h3{display:flex;align-items:center;gap:10px}
  .invtag{font-size:9.5px;letter-spacing:.12em;color:var(--neg);border:1px solid rgba(248,113,113,.4);
    border-radius:999px;padding:2px 8px;font-weight:600}
  .gaugelbl{text-align:center;font-family:var(--serif);font-size:19px;color:#fff;margin-top:-6px}
  .subnote{font-size:11px;color:var(--t3);margin-top:8px;line-height:1.5}
  .headlines{display:flex;flex-direction:column;gap:2px}
  .hl{display:block;padding:10px 0;border-top:1px solid var(--line);text-decoration:none;
    transition:opacity .15s}
  .hl:first-child{border-top:none}
  .hl:hover{opacity:.75}
  .hlt{display:block;font-size:13.5px;color:var(--t1);line-height:1.45}
  .hlm{display:block;font-family:var(--mono);font-size:10px;letter-spacing:.04em;
    color:var(--t3);margin-top:4px}

  /* section eyebrow */
  .sec{font-family:var(--mono);font-size:10.5px;letter-spacing:.28em;text-transform:uppercase;
    color:var(--t3);margin:46px 0 16px;display:flex;align-items:center;gap:16px}
  .sec::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,var(--line),transparent)}

  /* market-data grid */
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .panel{background:var(--glass);border:1px solid var(--line);border-radius:14px;padding:18px 20px 12px;
    backdrop-filter:blur(8px);box-shadow:0 1px 0 rgba(255,255,255,.02) inset,0 18px 40px -28px rgba(0,0,0,.8)}
  .panel h3{margin:0 0 8px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--accent);font-weight:600}
  table.tbl{width:100%;border-collapse:collapse}
  .tbl td{padding:9px 0;border-top:1px solid var(--line);font-size:13.5px;white-space:nowrap;vertical-align:middle}
  .tbl tr:first-child td{border-top:none}
  .tbl tr{transition:background .1s ease}
  .tbl tr:hover td{background:rgba(79,209,197,.05)}
  .tbl .nm{color:var(--t2)}
  .tbl .v{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums;color:#fff;
    font-weight:500;padding-left:18px}
  .tbl .v small{color:var(--t3);font-weight:400;margin-left:5px;font-size:10px}
  .tbl .c{text-align:right;width:104px;padding-left:14px;font-family:var(--mono);
    font-variant-numeric:tabular-nums;font-size:12px;color:var(--t3)}
  .tbl .c.pos{color:var(--pos)} .tbl .c.neg{color:var(--neg)}
  .tbl .sp{width:92px;text-align:right;padding-left:16px;line-height:0}
  .spark{display:inline-block;vertical-align:middle}
  .spark polyline{stroke-dasharray:var(--len);stroke-dashoffset:var(--len);animation:draw 1.1s ease forwards}
  @keyframes draw{to{stroke-dashoffset:0}}

  /* trends */
  .charts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .cpanel{background:var(--glass);border:1px solid var(--line);border-radius:14px;padding:14px 14px 6px;
    backdrop-filter:blur(8px)}
  .chead{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px}
  .chead .ct{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--t2)}
  .chead .cv{font-family:var(--mono);font-variant-numeric:tabular-nums;font-size:12px;color:#fff}
  .chead .cv small{color:var(--t3);font-weight:400;font-size:10px;margin-left:3px}

  /* explainer cards — the signature */
  .explain{display:grid;gap:14px}
  .ex{background:var(--glass);border:1px solid var(--line);border-left:2px solid var(--accent);
    border-radius:12px;padding:20px 24px;backdrop-filter:blur(8px)}
  .ex h4{margin:0 0 4px;font-family:var(--serif);font-weight:500;font-size:21px;color:#fff;letter-spacing:-.01em}
  .ex .what{color:var(--t2);font-size:13.5px;margin:0 0 14px;max-width:78ch}
  .ex .rowx{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .ex .blk .k{font-family:var(--mono);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;
    color:var(--accent);margin-bottom:5px}
  .ex .blk p{margin:0;font-size:13.5px;color:var(--t1);line-height:1.6}
  .ex .blk.matters p{color:var(--t2)}
  .ex b{color:#fff;font-weight:600} .ex i{color:var(--t3);font-style:normal}

  /* glossary */
  .gloss{background:var(--glass);border:1px solid var(--line);border-radius:12px;overflow:hidden}
  .gloss details{border-top:1px solid var(--line)}
  .gloss details:first-child{border-top:none}
  .gloss summary{cursor:pointer;padding:13px 20px;font-weight:600;font-size:13.5px;color:var(--t1);
    list-style:none;display:flex;align-items:center;justify-content:space-between}
  .gloss summary::-webkit-details-marker{display:none}
  .gloss summary .plus{color:var(--accent);font-family:var(--mono);transition:transform .2s}
  .gloss details[open] summary .plus{transform:rotate(45deg)}
  .gloss .body{padding:0 20px 15px;color:var(--t2);font-size:13.5px;max-width:80ch}

  /* briefing */
  .brief{border:1px solid var(--line);background:var(--glass);border-radius:14px;padding:8px 32px 28px;backdrop-filter:blur(8px)}
  .brief h1{display:none}
  .brief h2{font-family:var(--serif);font-weight:500;font-size:18px;color:#fff;margin:22px 0 8px;
    padding-top:16px;border-top:1px solid var(--line);letter-spacing:-.01em}
  .brief h2:first-of-type{border-top:none;padding-top:10px}
  .brief p{font-size:13.5px;color:var(--t2);margin:8px 0}
  .brief strong{color:var(--t1);font-weight:600} .brief em{color:var(--t3)}
  .brief code{font-family:var(--mono);font-size:12px;background:var(--panel-2);padding:1px 6px;
    border:1px solid var(--line);border-radius:4px;color:var(--accent)}
  .brief ul{margin:8px 0;padding-left:18px} .brief li{margin:5px 0;color:var(--t2);font-size:13px}

  footer{margin-top:44px;padding-top:18px;border-top:1px solid var(--line);color:var(--t3);
    font-size:11px;line-height:1.7}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @media (max-width:880px){
    .grid,.charts,.stats,.ex .rowx,.structure{grid-template-columns:1fr}
    .stats{border-radius:12px}
  }
  @media (prefers-reduced-motion:reduce){
    .rise{opacity:1;transform:none;transition:none}
    .spark polyline{animation:none;stroke-dashoffset:0}
  }
</style>
</head>
<body>
<div class="wrap">

  <header class="mast">
    <div class="brand"><span class="tick"></span>{{ title }}</div>
    <div class="clock">
      <div><span id="clock">--:--:--</span><span class="z">LOCAL</span></div>
      <div class="upd">Updated {{ generated_at }}</div>
    </div>
  </header>

  <section class="hero rise mood-{{ mood.icon }}">
    <div class="eyebrow">
      <span class="pill"><span class="dot"></span>Daily briefing</span>
      {% if data_date %}<span>Market close {{ data_date }}</span>{% endif %}
      <span>{{ tagline }}</span>
    </div>
    <div class="moodrow">
      <span class="moodtag">{{ mood.tag }}</span>
      <span class="moodsub">{{ mood.sub }}</span>
    </div>
    <h1 class="headline">{{ headline | safe }}</h1>
    {% if changed %}<div class="changed"><span class=" chgk">Since yesterday</span>{{ changed }}</div>{% endif %}

    <div class="stats">
      {% for s in hero_stats %}
      <div class="stat">
        <div class="l">{{ s.label }}</div>
        <div class="n"><span class="count" data-target="{{ s.raw }}" data-nd="{{ s.nd }}">{{ s.last }}</span>{% if s.unit %}<small>{{ s.unit }}</small>{% endif %}</div>
        <div class="d {{ s.dir }}">{{ s.chg }}</div>
        {% if s.range %}<div class="rangebar"><i style="left:{{ s.range.pct }}%"></i></div>
        <div class="rangelbl"><span>{{ s.range.lo }}</span><span>90d range</span><span>{{ s.range.hi }}</span></div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>

  {% if notable %}
  <div class="sec rise">Notable today</div>
  <div class="notable rise">
    {% for n in notable %}
    <div class="ntitem">
      <span class="ntnum">{{ '%02d'|format(loop.index) }}</span>
      <span class="nttxt">{{ n }}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="sec rise">Market structure</div>
  <div class="structure">
    <div class="panel curve rise">
      <h3>{{ yield_curve.title }}{% if yield_curve.inverted %}<span class="invtag">INVERTED</span>{% endif %}</h3>
      {{ yield_curve.html | safe }}
      {% if yield_curve.prior_date %}<div class="subnote">Dotted line: curve as of {{ yield_curve.prior_date }}</div>{% endif %}
    </div>
    <div class="panel gauge rise">
      <h3>Risk regime</h3>
      {{ risk_gauge.html | safe }}
      <div class="gaugelbl">{{ mood.tag }}</div>
      <div class="subnote" style="text-align:center;margin-top:-2px">({{ risk_gauge.label }})</div>
      <div class="subnote">Rules-based tally of VIX, credit, dollar &amp; curve momentum — not a black box.</div>
    </div>
  </div>

  {% if calendar or headlines %}
  <div class="sec rise">Big events</div>
  <div class="structure">
    <div class="panel rise">
      <h3>On the calendar</h3>
      {% if calendar %}
      <table class="tbl">
        {% for e in calendar %}
        <tr>
          <td class="nm">{{ e.name }}</td>
          <td class="c" style="width:auto;text-align:right;color:var(--t2)">{{ e.when }}</td>
        </tr>
        {% endfor %}
      </table>
      {% else %}<div class="subnote">No high-impact releases in the next two weeks.</div>{% endif %}
      <div class="subnote">Source: FRED release calendar — non-farm payrolls, CPI, PCE, GDP, FOMC, PPI, retail sales.</div>
    </div>
    <div class="panel rise">
      <h3>Energy headlines</h3>
      {% if headlines %}
      <div class="headlines">
        {% for h in headlines %}
        <a class="hl" href="{{ h.link }}" target="_blank" rel="noopener">
          <span class="hlt">{{ h.title }}</span>
          <span class="hlm">{{ h.source }}{% if h.published %} · {{ h.published }}{% endif %}</span>
        </a>
        {% endfor %}
      </div>
      {% else %}<div class="subnote">Headlines unavailable right now.</div>{% endif %}
    </div>
  </div>
  {% endif %}

  <div class="sec rise">Market data</div>
  <div class="grid">
    {% for g in groups %}
    <div class="panel rise">
      <h3>{{ g.title }}</h3>
      <table class="tbl">
        {% for r in g.rows %}
        <tr>
          <td class="nm">{{ r.label }}</td>
          <td class="v">{{ r.last }}{% if r.unit %}<small>{{ r.unit }}</small>{% endif %}</td>
          <td class="c {{ r.dir }}">{{ r.chg }}</td>
          <td class="sp">{{ r.spark | safe }}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% endfor %}
  </div>

  <div class="sec rise">Trends</div>
  <div class="charts">
    {% for c in charts %}
    <div class="cpanel rise">
      <div class="chead"><span class="ct">{{ c.title }}</span><span class="cv">{{ c.last }}<small>{{ c.unit }}</small></span></div>
      {{ c.html | safe }}
    </div>
    {% endfor %}
  </div>

  <div class="sec rise">Understand today</div>
  <div class="explain">
    {% for s in sections %}
    <div class="ex rise">
      <h4>{{ s.title }}</h4>
      <p class="what">{{ s.plain | safe }}</p>
      <div class="rowx">
        <div class="blk"><div class="k">What's happening today</div><p>{{ s.today | safe }}</p></div>
        <div class="blk matters"><div class="k">Why it matters</div><p>{{ s.matters | safe }}</p></div>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="sec rise">Key terms</div>
  <div class="gloss rise">
    {% for t in glossary %}
    <details>
      <summary>{{ t.term }}<span class="plus">+</span></summary>
      <div class="body">{{ t.def }}</div>
    </details>
    {% endfor %}
  </div>

  <div class="sec rise">Full morning briefing</div>
  <div class="brief rise">{{ briefing_html | safe }}</div>

  <footer>
    Built by an automated pipeline from public data (FRED, Open-Meteo), refreshed daily via GitHub Actions. Figures marked as assumptions have no free daily feed and are configurable. Educational project — not investment advice.
  </footer>
</div>

<script>
  // live clock
  (function(){var el=document.getElementById('clock');if(!el)return;
    function p(n){return(n<10?'0':'')+n}
    function t(){var d=new Date();el.textContent=p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds())}
    t();setInterval(t,1000);})();

  // scroll reveal
  (function(){
    var els=[].slice.call(document.querySelectorAll('.rise'));
    if(!('IntersectionObserver'in window)){els.forEach(function(e){e.classList.add('in')});return;}
    var io=new IntersectionObserver(function(es){es.forEach(function(en){
      if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);}})},{threshold:.12});
    els.forEach(function(e,i){setTimeout(function(){io.observe(e)},Math.min(i*40,300))});
  })();

  // count-up on hero stats
  (function(){
    var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.count').forEach(function(el){
      var target=parseFloat(el.getAttribute('data-target'));
      var nd=parseInt(el.getAttribute('data-nd')||'2',10);
      if(isNaN(target)||reduce){return;}
      var start=performance.now(),dur=900;
      function fmt(v){return v.toLocaleString(undefined,{minimumFractionDigits:nd,maximumFractionDigits:nd});}
      function step(now){var k=Math.min(1,(now-start)/dur);var e=1-Math.pow(1-k,3);
        el.textContent=fmt(target*e);if(k<1)requestAnimationFrame(step);else el.textContent=fmt(target);}
      requestAnimationFrame(step);
    });
  })();

  // animate sparkline draw length
  (function(){
    document.querySelectorAll('.spark polyline').forEach(function(pl){
      try{var L=pl.getTotalLength();pl.style.setProperty('--len',L);}catch(e){}
    });
  })();
</script>
</body>
</html>

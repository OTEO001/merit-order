# Copy this file to ".env" and paste your keys after the "=" signs.
# .env is git-ignored — your keys never get committed. The bootstrap script
# reads them from here and pushes them into GitHub's encrypted Actions secrets.
# Do NOT share this file or paste these values into chats / screenshots.

# REQUIRED — the one key the product needs.
# Free, instant: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# OPTIONAL — only if you later enable EIA-native datasets (FRED already covers gas/oil).
# Free: https://www.eia.gov/opendata/register/
EIA_API_KEY=

# OPTIONAL — turns on the LLM "polish" pass that rewrites the briefing prose.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OPTIONAL — European power module (live spark spreads). Request via the
# ENTSO-E Transparency Platform, then set ENABLE_ENTSOE=true as a repo variable.
ENTSOE_TOKEN=
